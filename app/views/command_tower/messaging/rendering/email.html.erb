<table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f4f5f7; padding: 32px 16px;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <tr>
          <td style="padding: 28px 28px 8px 28px;">
            <h1 style="margin: 0; color: #1a202c; font-size: 22px; font-weight: 600; line-height: 1.35;">
              <%= h.call(title) %>
            </h1>
          </td>
        </tr>
        <tr>
          <td style="padding: 8px 28px 28px 28px;">
            <p style="margin: 0; color: #4a5568; font-size: 16px; line-height: 1.6; white-space: pre-wrap;">
<%= h.call(body) %></p>
            <% if deep_link -%>
            <p style="margin: 24px 0 0 0;">
              <a href="<%= h.call(deep_link) %>" style="color: #2b6cb0; font-size: 14px; text-decoration: underline;">
                <%= h.call(deep_link) %>
              </a>
            </p>
            <% end -%>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
