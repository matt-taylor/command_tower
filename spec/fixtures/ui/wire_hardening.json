      { "name": "key_value_items_at_limit", "build": { "kind": "key_value_items", "count": 50 }, "valid": true },
      {
        "name": "key_value_items_over_limit",
        "build": { "kind": "key_value_items", "count": 51 },
        "valid": false,
        "error": { "path": "root.items", "code": "too_many_items" }
      },
      { "name": "facts_nodes_at_limit", "build": { "kind": "facts_children", "count": 100 }, "valid": true },
      {
        "name": "facts_nodes_over_limit",
        "build": { "kind": "facts_children", "count": 101 },
        "valid": false,
        "error": { "path": "root", "code": "too_many_facts_nodes" }
      },
      {
        "name": "bytes_over_limit",
        "build": { "kind": "fat_texts", "count": 40, "length": 2000 },
