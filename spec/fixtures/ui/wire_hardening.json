    "maxKeyValueItems": 50,
    "maxFactsNodes": 100,
    "cases": [
      { "name": "nodes_at_limit", "build": { "kind": "flat_stack", "nodes": 200 }, "valid": true },
      {
        "name": "nodes_over_limit",
